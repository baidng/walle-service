# walle 服务保密配置示例
#
# 使用方式：
#   cp etc/walle.conf.example etc/walle.conf
#   把下面的占位值替换为真实凭据，并执行 chmod 600 etc/walle.conf
#
# 该文件含密钥，已在 .gitignore 中排除，禁止提交。
# 运行时由 walle.service 通过 EnvironmentFile 加载。

# EMQX Access Control -> API Keys 生成的凭据
EMQX_API_KEY=<你的 api_key>
EMQX_API_SECRET=<你的 api_secret>

# EMQX 规则引擎回调 walle_api 的共享 token（告警落库）
# 生成方式：python3 -c "import secrets; print(secrets.token_hex(24))"
WALLE_INGEST_TOKEN=<你的 ingest token>

# 告警保留天数（按 occurred_at 计算），默认 30
# WALLE_ALARM_RETENTION_DAYS=30

